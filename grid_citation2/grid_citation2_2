cnt=0
devices=(3 4 5 6 7)
epoch=75
ratio=0.02
c=1
dataset=ogbl_citation2
convergence=1.0

for pos_ratio in 1.3 1.4 1.5; do
    for seed in 1 2 3 4 5; do
        device_cnt=$((cnt % ${#devices[@]}))  
        device=${devices[$device_cnt]}

        echo "Started processing dataset: $dataset, ratio: $ratio, seed: $seed on device: $device"
        CUDA_VISIBLE_DEVICES=$device nohup python dir_main_oi_compact_speedup.py --dataset $dataset --split_ratio $ratio\
        --h 15 --tp 16 --c $c --neg 1 --gamma 3 --pos_ratio $pos_ratio --alpha 3 --epoch $epoch --batch_edge 65536 \
        --seed $seed --chunks 16 --convergence $convergence --eval_step 5 \
        > ./grid_citation2/logs_2/c${c}-conv${convergence}-pos${pos_ratio}-s${seed}-r${ratio}.log 2>&1 &

        cnt=$((cnt + 1))
        if [ $cnt -eq 5 ]; then
            cnt=0
            wait
        fi
    done
done
echo "$dataset processing completed."
