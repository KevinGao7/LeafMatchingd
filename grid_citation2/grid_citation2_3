# 156

cnt=0
devices=(2 3 4 5 6 7)
epoch=50
ratio=0.02
c=1
dataset=ogbl_citation2
convergence=1.0
pos_ratio=1.2

# gamma=3.5, epoch=30, alpha=8, pos_ratio=1.2, convergence=1.0, c=1

for gamma in 2.5 2.75 3 3.25 3.5; do # 5
    for alpha in 1 2.5 3 3.5 5 8; do # 6
        for seed in 1 2 3 4 5; do # 5
            device_cnt=$((cnt % ${#devices[@]}))  
            device=${devices[$device_cnt]}

            echo "Started processing dataset: $dataset, ratio: $ratio, seed: $seed on device: $device"
            CUDA_VISIBLE_DEVICES=$device nohup python dir_main_oi_compact_speedup.py --dataset $dataset --split_ratio $ratio\
            --h 15 --tp 16 --c $c --neg 1 --gamma $gamma --pos_ratio $pos_ratio --alpha $alpha --epoch $epoch --batch_edge 65536 \
            --seed $seed --chunks 16 --convergence $convergence --eval_step 5 \
            > ./grid_citation2/logs_3/g${gamma}-a${alpha}-s${seed}-r${ratio}.log 2>&1 &

            cnt=$((cnt + 1))
            if [ $cnt -eq ${#devices[@]} ]; then
                cnt=0
                wait
            fi
        done
    done
done
echo "$dataset processing completed."
